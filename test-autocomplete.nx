// Test file for autocomplete with function signatures

function calculateSum(a: number, b: number): number {
    return a + b;
}

function greetPerson(name: string, age: number): string {
    return `Hello ${name}, you are ${age} years old`;
}

function processData(input: string, options: object, callback: function): void {
    callback(input);
}

class Calculator {
    func add(x: number, y: number): number {
        return x + y;
    }

    func multiply(first: number, second: number): number {
        return first * second;
    }

    func divide(numerator: number, denominator: number): number {
        return numerator / denominator;
    }

    func calculate(operation: string, value1: number, value2: number): number {
        return 0;
    }
}

const calc = new Calculator();

